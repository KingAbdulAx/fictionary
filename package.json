{
  "name": "fictionary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "npx -y concurrently \"npm run server\" \"npm run dev\"",
    "words": "node scripts/build-words.mjs",
    "check:words": "node scripts/check-words.mjs",
    "build": "node scripts/check-words.mjs && vite build",
    "build:hub": "node scripts/check-words.mjs && cross-env VITE_BASE=/fictionary/ vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test server/test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wordnet-db": "3.1.14"
  }
}
