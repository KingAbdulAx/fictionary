# Copy to .env.local for local overrides. In production set these in Vercel
# (Settings > Environment Variables) and redeploy; Vite bakes them in at build time.

# Socket.IO game server, no trailing slash. REQUIRED for production builds.
# In dev it defaults to http://localhost:3001 when unset.
# Production example: https://fictionary-api.azedlabs.com (whatever host the server is deployed on)
VITE_SERVER_URL=http://localhost:3001

# Public base path when served under the games hub. Use /fictionary/ for games.azedlabs.com/fictionary/
# (default /)
# VITE_BASE=/fictionary/

# Optional: Socket.IO path on the server (default /socket.io)
# VITE_SOCKET_PATH=/socket.io

# Game server (set on the server, i.e. in Coolify, not in Vercel):
#   ALLOWED_ORIGINS  comma-separated browser origins allowed to connect, WebSockets included.
#                    Unset means any origin. Example:
#                    ALLOWED_ORIGINS=https://games.azedlabs.com,http://localhost:5173
#   PORT             defaults to 3001
#   TIMER_SECOND_MS  test-only: milliseconds per timer second (default 1000). The e2e run sets it low.
